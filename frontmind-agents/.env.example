# Configuración del Backend — FrontMind AI
# Copia este archivo a .env y asigna valores reales. NUNCA subas .env al repositorio.
# En HuggingFace Spaces configúralos como "Secrets" del Space, no en el código.

# Entorno: production (por defecto, falla cerrado) | development (permite correr sin claves)
FRONTMIND_ENV=production

# Obligatorio: clave compartida con el frontend (header X-API-Key).
# Va en el bundle del navegador, así que NO es la barrera de seguridad principal.
BACKEND_API_KEY=generar_con_python_-c_"import secrets;print(secrets.token_urlsafe(32))"

# Obligatorio: verificación del access token de Supabase de cada usuario
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU_ANON_KEY

# Para el endpoint POST /auth/verify-email
ABSTRACT_API_KEY=tu_api_key_de_abstract
# Opcional: endpoint de Abstract (Email Reputation por defecto)
# ABSTRACT_API_URL=https://emailreputation.abstractapi.com/v1/

# Orígenes CORS permitidos (separados por coma, nunca "*")
ALLOWED_ORIGINS=https://frontmind-frontend.onrender.com,http://localhost:5173

# URL pública base para las capturas
API_BASE_URL=https://lizrosas-proyectotesisback.hf.space

# Detrás de un proxy (HF Spaces / Render): usar X-Forwarded-For para el rate limit
TRUST_PROXY_HEADERS=true

# Capacidad y retención
MAX_CONCURRENT_CAPTURES=2
CAPTURE_RETENTION_HOURS=24
MAX_ZIP_MB=20

# Documentación /docs (desactivada por defecto en producción)
DOCS_ENABLED=false
