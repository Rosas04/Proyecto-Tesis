# Configuración del Backend — FrontMind AI
# Copia este archivo a .env y asigna valores reales

# Obligatorio para asegurar todos los endpoints
BACKEND_API_KEY=generar_un_uuid_o_token_seguro

# Para el endpoint POST /auth/verify-email
ABSTRACT_API_KEY=tu_api_key_de_abstract

# Orígenes CORS permitidos (separados por coma)
ALLOWED_ORIGINS=https://lizrosas-proyectotesisback.hf.space,http://localhost:5173

# Opcional: URL base para las rutas de los archivos capturados
API_BASE_URL=https://lizrosas-proyectotesisback.hf.space
