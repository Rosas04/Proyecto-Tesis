# Claves de acceso a Supabase (la anon key es pública por diseño; la seguridad
# de los datos depende de las políticas RLS: ver supabase/migrations/)
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI

# URL del Backend (HuggingFace Spaces en producción, 8001 en local)
VITE_API_URL=http://127.0.0.1:8001

# Clave compartida con el backend (BACKEND_API_KEY). Se incluye en el bundle JS,
# por lo que NO es un secreto: el backend autentica a cada usuario con su
# access token de Supabase. No reutilices aquí ninguna otra clave.
VITE_BACKEND_API_KEY=
